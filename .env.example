# Google Doc id (extract from URL: docs.google.com/document/d/<DOC_ID>/edit)
# Doc must be shared as "Anyone with the link: Viewer".

# Main vocab doc — sections (## new / ## learned / ## ignored)
# per line: en | translation | phrase | phrase translation
VITE_VOCAB_DOC_ID=

# Tense-examples doc — sections (## <tense_code>) with 3 forms per tense
# per line: + | english | russian  (or - / ? for negative / question)
VITE_TENSE_EXAMPLES_DOC_ID=

# Sentences manifest doc — list of word→doc-id mappings (one per line)
# per line: <word> | <doc_id>
VITE_SENTENCES_MANIFEST_DOC_ID=

# Irregular verbs doc — flat list of irregular verbs
# per line: v1 | v2 | v3 | перевод | freq (high|medium|low)
VITE_IRREGULAR_VERBS_DOC_ID=
